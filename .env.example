# --- Telegram ---
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Optional: restrict bot to a comma-separated list of Telegram user IDs.
# Leave empty to allow anyone who finds the bot.
ALLOWED_USER_IDS=

# --- Polymarket ---
# These are public; defaults are fine
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# --- Value detection defaults ---
# Minimum edge (fair_prob - market_prob) in percentage points to flag a play
DEFAULT_MIN_EDGE_PCT=4.0

# Minimum confidence score (0-100) for /value to surface a play
DEFAULT_MIN_CONFIDENCE=55

# Minimum liquidity (USDC) to consider a market tradable
MIN_LIQUIDITY_USDC=2000

# --- Scheduler ---
# How often (seconds) to refresh prices on tracked games
TRACK_REFRESH_SECONDS=120

# How often (seconds) to re-scan for value plays for subscribed users
VALUE_SCAN_SECONDS=600

# --- Logging ---
LOG_LEVEL=INFO
